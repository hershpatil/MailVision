# =====================================================================
# MailVision - Environment Configuration Example
# =====================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file or OAuth tokens to source control.

# Flask Application Secret Key
# Used for session cookie signing and symmetric authenticated encryption of OAuth tokens at rest.
FLASK_SECRET_KEY=mailvision-secret-key-change-in-production-2026

# Google Cloud OAuth 2.0 Web Application Credentials
# Obtain these from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authorized Redirect URI
# In development: http://127.0.0.1:5000/gmail/callback
# In Vercel production: https://<your-project-name>.vercel.app/gmail/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/gmail/callback

# Batch size for on-demand Gmail inbox scanning (default: 5 emails)
GMAIL_SCAN_BATCH_SIZE=5

# Database Configuration:
# Leave empty for local development (uses local SQLite at database/predictions.db).
# In production on Vercel, attach a PostgreSQL database (e.g., Vercel Postgres, Neon, Supabase):
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=
